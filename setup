#!/bin/bash
# setup  --  SetupHelper-kompatibler Installer fuer dbus-openwb2
#
# Ermoeglicht Installation/Update/Deinstallation ueber den "Package Manager"
# des SetupHelper von Kevin Windrem (https://github.com/kwindrem/SetupHelper).
# SetupHelper uebernimmt Download, Versionierung und die automatische
# Neuinstallation nach Venus-OS-Firmware-Updates.
#
# Manuelle Installation ohne SetupHelper: stattdessen ./install.sh verwenden.
#
# Hinweis: Gegen die SetupHelper-HelperResources-API entwickelt; auf Hardware
# noch nicht getestet (Beta). Die Reboot-Persistenz ist zusaetzlich ueber einen
# rc.local-Eintrag abgesichert, damit die Dienste unabhaengig von der
# SetupHelper-Version einen normalen Neustart ueberleben.

pkgDir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
pkgName=$( basename "$pkgDir" )

RELINK="ln -sfn \"$pkgDir/service\" /service/dbus-openwb2; ln -sfn \"$pkgDir/service-web\" /service/dbus-openwb2-web"

# SetupHelper einbinden -------------------------------------------------------
source "/data/SetupHelper/HelperResources/IncludeHelpers" 2>/dev/null
if [ $? -ne 0 ]; then
    echo
    echo "FEHLER: SetupHelper wurde nicht gefunden."
    echo "Dieses setup-Script benoetigt den SetupHelper von Kevin Windrem."
    echo "Ohne SetupHelper bitte  ./install.sh  verwenden."
    echo
    exit 1
fi

# Bei manuellem Aufruf: Aktion abfragen
if [ $scriptAction == 'NONE' ] ; then
    standardActionPrompt
fi

normalize_and_perms()
{
    for f in dbus-openwb2.py webconfig.py \
             service/run service/log/run service-web/run service-web/log/run \
             install.sh uninstall.sh restart.sh setup ; do
        if [ -f "$pkgDir/$f" ]; then
            grep -q $'\r' "$pkgDir/$f" && sed -i 's/\r$//' "$pkgDir/$f"
            chmod 755 "$pkgDir/$f"
        fi
    done
}

link_services()
{
    # 1) SetupHelper-Weg (persistent nach /opt/victronenergy/service), falls verfuegbar
    if command -v installService >/dev/null 2>&1 ; then
        installService dbus-openwb2     "$pkgDir/service"     2>/dev/null
        installService dbus-openwb2-web "$pkgDir/service-web" 2>/dev/null
    fi
    # 2) Direkte Symlinks -> sofort aktiv
    eval "$RELINK"
    # 3) rc.local-Eintrag -> garantiert Reboot-Persistenz (svscan startet die Links)
    grep -qF "$RELINK" /data/rc.local 2>/dev/null || {
        [ -f /data/rc.local ] || { echo "#!/bin/bash" > /data/rc.local; chmod 755 /data/rc.local; }
        echo "$RELINK" >> /data/rc.local
    }
}

#### INSTALL -----------------------------------------------------------------
if [ $scriptAction == 'INSTALL' ] ; then
    logMessage "dbus-openwb2: Installation"

    # Abhaengigkeit paho-mqtt (gebuendelte Kopie unter ext/ bevorzugen)
    if ! PYTHONPATH="$pkgDir/ext/paho-mqtt" python3 -c "import paho.mqtt.client" 2>/dev/null ; then
        python3 -m pip install paho-mqtt \
            || { opkg update && opkg install python3-pip && python3 -m pip install paho-mqtt; }
    fi

    # config.ini aus Vorlage anlegen (nur beim ersten Mal)
    if [ ! -f "$pkgDir/config.ini" ]; then
        cp "$pkgDir/config.sample.ini" "$pkgDir/config.ini"
        logMessage "config.ini aus Vorlage erstellt - im Web-Interface konfigurieren."
    fi

    normalize_and_perms
    link_services

    # Dienste (neu) starten, damit bei einem Update die neuen Dateien greifen
    for s in dbus-openwb2 dbus-openwb2-web; do
        for _ in 1 2 3 4 5 6 7 8; do
            svok "/service/$s" 2>/dev/null && break
            sleep 1
        done
        svc -t "/service/$s" 2>/dev/null || true
    done

    restartGui=true
    endScript
fi

#### UNINSTALL ---------------------------------------------------------------
if [ $scriptAction == 'UNINSTALL' ] ; then
    logMessage "dbus-openwb2: Deinstallation"
    command -v removeService >/dev/null 2>&1 && {
        removeService dbus-openwb2     2>/dev/null
        removeService dbus-openwb2-web 2>/dev/null
    }
    # rc.local-Eintrag entfernen
    sed -i "\#$pkgDir/service#d" /data/rc.local 2>/dev/null
    for s in dbus-openwb2 dbus-openwb2-web; do
        svc -dx "/service/$s" "/service/$s/log" 2>/dev/null
        rm -f "/service/$s"
    done
    kill "$(pgrep -f "dbus-openwb2.py")" 2>/dev/null
    kill "$(pgrep -f "webconfig.py")" 2>/dev/null
    restartGui=true
    endScript
fi
